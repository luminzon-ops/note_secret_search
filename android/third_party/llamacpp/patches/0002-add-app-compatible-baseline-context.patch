@@ -0,0 +1,32 @@
+package com.example.nssllama
+
+import org.nehuatl.llamacpp.LlamaContext
+
+class SilentLlamaContext(
+    val id: Int,
+    params: Map<String, Any>,
+) {
+    private val delegate = LlamaContext(id, params)
+
+    val context: Long
+        get() = delegate.context
+
+    val modelDetails: Map<String, Any?>
+        get() = delegate.modelDetails
+
+    fun setTokenCallback(callback: (String) -> Unit) {
+        delegate.setTokenCallback(callback)
+    }
+
+    fun completion(params: Map<String, Any>): Map<String, Any?> {
+        return delegate.completion(params)
+    }
+
+    fun stopCompletion() {
+        delegate.stopCompletion()
+    }
+
+    fun release() {
+        delegate.release()
+    }
+}
