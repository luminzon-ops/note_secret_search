+using LlamaContextPtr = std::shared_ptr<rnllama::llama_rn_context>;
+
+std::mutex context_map_mutex;
+std::unordered_map<long, LlamaContextPtr> context_map;
+
+static LlamaContextPtr findContext(long context_ptr) {
+    std::lock_guard<std::mutex> lock(context_map_mutex);
+    auto found = context_map.find(context_ptr);
+    return found == context_map.end() ? nullptr : found->second;
+}
+
+static LlamaContextPtr beginContextGeneration(long context_ptr) {
+    std::lock_guard<std::mutex> lock(context_map_mutex);
+    auto found = context_map.find(context_ptr);
+    if (found == context_map.end() || found->second->released.load()) {
+        return nullptr;
+    }
+    auto llama = found->second;
+    llama->is_interrupted.store(false);
+    llama->is_predicting.store(true);
+    return llama;
+}
+
+static void installContext(const LlamaContextPtr &llama) {
+    std::lock_guard<std::mutex> lock(context_map_mutex);
+    context_map.emplace((long) llama->ctx, llama);
+}
+
+static LlamaContextPtr takeContext(long context_ptr) {
+    std::lock_guard<std::mutex> lock(context_map_mutex);
+    auto found = context_map.find(context_ptr);
+    if (found == context_map.end()) {
+        return nullptr;
+    }
+    auto llama = found->second;
+    context_map.erase(found);
+    llama->released.store(true);
+    llama->is_interrupted.store(true);
+    return llama;
+}
